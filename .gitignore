# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every real one stays out
.env*
# ...except the template, which holds only placeholders and is meant to be read.
# The broad rule above still catches .env, .env.local, .env.production etc.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Locally-installed agent skills (npx skills add) — keep out of the product repo
.agents/
.claude/
skills-lock.json

# impeccable (npx impeccable install) — local AI-harness tooling, not product code
.codex/
.github/agents/
.github/hooks/
.github/skills/
