# ─────────────────────────────────────────────────────────────────────────────
# Environment variables. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env*` is gitignored. Nothing in this file is a real credential — the values
# below are placeholders and format hints only.
#
# WHAT BELONGS IN HERE, AND WHAT DOESN'T
# --------------------------------------
# Two things, and only two: secrets, and values that genuinely differ between
# local / preview / production.
#
# Company details — support email, phone number, registered address, social
# handles, crisis helplines — are NOT in here. They live in `src/config/site.ts`
# as ordinary constants, because they are neither secret (they are printed on
# the public website) nor per-deployment (they are identical everywhere). Put
# them in the environment and you get a value with no diff, no code review and
# no rollback, plus a way to ship a live site showing a placeholder phone
# number. Edit that file instead.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (required) ──────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL is the pooled connection the app runs on; DIRECT_URL bypasses the
# pooler and is what `prisma migrate` needs. Both are required.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"


# ── Auth (required) ──────────────────────────────────────────────────────────
# Sessions are signed with NEXTAUTH_SECRET. Generate one with:
#     openssl rand -base64 32
# Changing it invalidates every existing session, signing everyone out.
NEXTAUTH_SECRET=""

# The full origin NextAuth builds callback URLs from. Per-deployment: it is
# http://localhost:3000 locally and the real domain in production. Vercel
# preview builds need their own.
NEXTAUTH_URL="http://localhost:3000"

# The public origin, used for canonical URLs, SEO metadata, referral links and
# the llms.txt route. Read in the browser as well as on the server, so it must
# be NEXT_PUBLIC_. Usually the same value as NEXTAUTH_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ── Google sign-in (optional) ────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ── Email (optional) ─────────────────────────────────────────────────────────
# Resend (https://resend.com) sends email OTPs. Without RESEND_API_KEY the
# email-OTP sign-in route fails; phone OTP and password sign-in still work.
RESEND_API_KEY=""

# The From header. The domain must be verified in Resend or delivery fails.
EMAIL_FROM="Example Care <noreply@example.com>"


# ── Phone OTP (optional) ─────────────────────────────────────────────────────
# MSG91 (https://msg91.com) sends SMS OTPs. See docs/MSG91_SETUP.md.
# Without these, phone sign-in is unavailable.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# The DLT-approved template used to text a member's emergency contact when the
# member raises a crisis alert from their dashboard. Without it that SMS is not
# sent — the alert still reaches the care team and admins, and the member is
# told explicitly to call their contact themselves rather than being left to
# assume a message went out.
MSG91_CRISIS_TEMPLATE_ID=""


# ── Video calls (optional) ───────────────────────────────────────────────────
# 100ms (https://100ms.live) → Dashboard → Developer.
# Without these, the join-call button has nothing to join.
HMS_ACCESS_KEY=""
HMS_SECRET=""
HMS_SUBDOMAIN=""       # the <subdomain> in <subdomain>.app.100ms.live
HMS_TEMPLATE_ID=""

# Role names as spelled in your 100ms template. Per-deployment because they
# depend on how that template was set up. Defaults suit the stock template.
HMS_ROLE_HOST="host"
HMS_ROLE_GUEST="guest"


# ── AI (optional) ────────────────────────────────────────────────────────────
# At least one provider key is needed for live AI. With neither, the pipeline
# degrades to transparent rule-based behaviour rather than breaking — see
# docs/AI_SETUP.md.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Shared secret authenticating the scheduled insight cron routes. Any long
# random string; the caller must send it as a bearer token.
CRON_SECRET=""


# ── Seeding (optional, non-production) ───────────────────────────────────────
# Shared password for the accounts `npm run db:seed` creates. A credential, so
# it belongs here rather than in the source. Defaults to DemoSeed@2026, which is
# printed in the repository — set this for any deployment others can reach.
SEED_PASSWORD=""
