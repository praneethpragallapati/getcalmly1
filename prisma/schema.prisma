generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for serverless runtime (Supabase transaction pooler / Neon pooled).
  url       = env("DATABASE_URL")
  // Direct connection for `prisma migrate` (Supabase session pooler / Neon direct).
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AssessmentType {
  ADULT
  CHILD
  COUPLE
  PSYCHIATRY
}

enum SeverityLevel {
  MINIMAL
  MILD
  MODERATE
  SEVERE
}

// Whether a patient is currently in individual or couple care. A patient can be
// moved between modes over time; when in COUPLE mode they also carry a coupleId
// shared with their partner, while keeping their own stable individual patientId.
enum CareMode {
  INDIVIDUAL
  COUPLE
}

// A person attached to a patient's care context — a partner (for couples work)
// or a child/dependent (for child & adolescent therapy).
enum RelationType {
  PARTNER
  CHILD
  DEPENDENT
}

// The "Paid member" sub-category a patient sits in. Distinct from CareMode:
// CareMode is the clinical individual/couple distinction; CareCategory is the
// product bucket the subscription is sold under (Individual / Couple / Kids).
// A patient can switch between these (e.g. individual <-> couple, #19).
enum CareCategory {
  INDIVIDUAL
  COUPLE
  KIDS
}

// A clinician's engagement with GetCalmly. Full-time clinicians are salaried, so
// per-session earnings do not apply to them; part-time clinicians are paid per
// completed session and see the earnings ledger. Set by an admin only.
enum EmploymentType {
  FULL_TIME
  PART_TIME
}

// Tenure-based membership tier. Derived from the number of paid months on an
// active subscription (#18) and surfaced as a badge across the app.
enum PlanTier {
  STARTER // < 3 paid months
  BRONZE // 3–5 months
  SILVER // 6–11 months
  GOLD // 12–23 months
  PLATINUM // 24+ months
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

// Kind of expert-assigned task surfaced in the Home > Tasks tab (#16).
enum TaskType {
  EXERCISE
  VIDEO
  READING
  REFLECTION
  BREATHING
}

enum InsightKind {
  DAILY // home-page daily insight from mood tracker (#10)
  WEEKLY // weekly journal insight (#12)
}

enum ChatRole {
  USER
  ASSISTANT
}

enum TherapistApplicationStatus {
  APPLIED
  INTERVIEW_SCHEDULED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Role shown next to a community author. PAID_MEMBER carries a tenure-based star
// tier; clinicians (THERAPIST / PSYCHIATRIST) and ADMIN are verified badges.
enum CommunityRole {
  PAID_MEMBER
  MEMBER
  THERAPIST
  PSYCHIATRIST
  ADMIN
}

// Kind of clinical form in the library — drives grouping and default-send rules.
enum FormKind {
  INTAKE // information form collected before the first session
  CONSENT // consent / agreement to be acknowledged
  INFO // general information sheet / questionnaire
  FEEDBACK // post-session or periodic feedback
}

enum FormStatus {
  PENDING // sent to the patient, awaiting completion
  COMPLETED // patient has submitted responses
}

// Lifecycle of a medicine home-delivery order. The actual pharmacy fulfilment
// (Tata 1mg etc.) is integrated later; PAID means the patient has paid in-app
// and the order is queued for dispatch.
enum MedicationOrderStatus {
  PENDING_PAYMENT
  PAID
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  image         String?
  // Salted scrypt hash for email+password sign-in (scrypt$salt$hash). Null for
  // accounts that only use OAuth / OTP. Never the raw password.
  passwordHash  String?
  role          Role      @default(PATIENT)
  // Set when an admin creates the account with a temporary password; forces a
  // password change on next sign-in.
  mustChangePassword Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  therapistProfile    TherapistProfile?
  patientProfile      PatientProfile?
  assessments         Assessment[]
  patientAppointments Appointment[]      @relation("PatientAppointments")
  moodEntries         MoodEntry[]
  journalEntries      JournalEntry[]
  blogPosts           BlogPost[]
  communityPosts      CommunityPost[]    @relation("UserCommunityPosts")
  communityComments   CommunityComment[] @relation("UserCommunityComments")
  communityUpvotes    CommunityUpvote[]  @relation("UserCommunityUpvotes")
  pollVotes           PollVote[]         @relation("UserPollVotes")
  subscriptions       Subscription[]
  payments            Payment[]
  tasks               Task[]
  medications         Medication[]
  privacySettings     PrivacySettings?
  aiProfile           AiProfile?
  aiInsights          AiInsight[]
  calmAiMessages      CalmAiMessage[]
  clinicalContext     ClinicalContext?
  assessmentScores    AssessmentScore[]
  crisisAlerts        CrisisAlert[]
  formAssignments     FormAssignment[]
  medicationOrders    MedicationOrder[]
  notifications       Notification[]
  sessionReviews      SessionReview[]    @relation("PatientReviews")

  // Referral program. referralCode is this user's own shareable code; a referred
  // user carries referredById. walletCreditRupees is store credit applied at
  // checkout; bonusSessions are free sessions added to the next package purchase.
  referralCode        String?  @unique
  referredById        String?
  walletCreditRupees  Int      @default(0)
  bonusSessions       Int      @default(0)
  referralsMade       Referral[] @relation("ReferralReferrer")
  referralReceived    Referral?  @relation("ReferralReferee")
}

// Patient-side record holding identity, care context, contacts and consents.
model PatientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stable, human-readable individual identifier (e.g. "GC-P-000123"). A patient
  // keeps this for life, regardless of moving between individual and couple care.
  patientId String   @unique
  // Shared identifier across both partners in a couple; null for individuals.
  // Both partners still keep their own patientId.
  coupleId  String?
  careMode  CareMode @default(INDIVIDUAL)
  // Admin-set clinician assignment override. When null, the assigned clinician
  // is derived from the patient's most recent appointment. Kept as the default
  // (category-agnostic) assignment.
  assignedTherapistId String?
  // Per-care-type clinician assignments (TherapistProfile ids). A patient can be
  // seen by a different expert for individual therapy, couples and psychiatry.
  assignedTherapistIndividualId String?
  assignedTherapistCouplesId    String?
  assignedTherapistPsychiatryId String?

  // What the patient is being treated for — concern "tracks" (e.g. ["anxiety",
  // "postpartum"]). Drives matching, the care journey, and clinician context.
  track String[]

  // Display + clinical context the AI pipeline reads (mirrors the notebook
  // `patients.json` vocabulary so the expert dashboard and the AI share fields).
  // A human-readable label for the primary track (e.g. "Anxiety and Overthinking")
  // and an optional finer sub-track. trackLabel is an override; when null it is
  // derived from the track slug in code (lib/tracks.ts).
  trackLabel       String?
  subTrack         String?
  // Working clinical diagnosis, expert-authored (e.g. "Generalized Anxiety Disorder").
  diagnosis        String?
  // Free-text situational note the AI must read before suggesting actions, so it
  // never proposes partner/relationship steps that don't fit the patient's life.
  currentSituation String? @db.Text
  // Lifecycle of care (e.g. "active", "paused", "discharged").
  therapyStatus    String?

  // Personal & contact
  dateOfBirth       DateTime?
  gender            String?
  country           String    @default("IN") // ISO 3166-1 alpha-2, India default
  // Indian state / UT the patient lives in (free text, e.g. "Karnataka"). Used
  // for admin/clinician filtering and regional reporting.
  state             String?
  preferredLanguage String?

  // Emergency contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Consents (mental-health sensitive — captured explicitly at signup)
  dataRetentionConsent  Boolean   @default(false)
  // Whether de-identified data may be shared with LLM partners; user can toggle
  // this off later from settings without affecting other services.
  llmDataSharingConsent Boolean   @default(false)
  aiDisclaimerAck       Boolean   @default(false)
  liabilityAck          Boolean   @default(false)
  termsAcceptedAt       DateTime?

  relatedPeople RelatedPerson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId])
}

// A partner or child/dependent linked to a patient's care context.
model RelatedPerson {
  id          String         @id @default(cuid())
  profileId   String
  profile     PatientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  relation    RelationType
  name        String
  dateOfBirth DateTime?
  gender      String?
  phone       String?
  email       String?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([profileId])
}

// Specialist onboarding application. Submitted from the "For Therapists" signup,
// routed to admins for verification + interview before a TherapistProfile is live.
model TherapistApplication {
  id                   String                     @id @default(cuid())
  fullName             String
  email                String
  phone                String
  council              String // "RCI", "NMC", or "RCI+NMC"
  registrationNo       String
  yearsExp             Int
  qualifications       String[]
  specializations      String[]
  languages            String[]
  bio                  String?                    @db.Text
  documentUrls         String[] // uploaded certificates, registration proof, ID
  preferredInterviewAt DateTime?
  status               TherapistApplicationStatus @default(APPLIED)
  reviewerNotes        String?                    @db.Text
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
}

model TherapistProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  bio             String   @db.Text
  qualifications  String[]
  yearsExp        Int
  languages       String[]
  specializations String[]
  rciNumber       String   @unique
  sessionFee      Int
  // Clinician's gender (for patient preference/matching) and the kind of
  // clinician they are, captured at onboarding: "Therapist" | "Psychiatrist" |
  // "Child specialist" | "Couples therapist" | ...
  gender          String?
  clinicianType   String?
  rating          Float    @default(0)
  totalReviews    Int      @default(0)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  // Salaried (full-time) or paid-per-session (part-time). Admin-managed; gates
  // the earnings ledger in the expert portal.
  employmentType  EmploymentType @default(FULL_TIME)
  // Per-therapist earnings overrides. Null on any field → use the global
  // EarningsConfig value for that component. Admin-editable on the profile, so a
  // clinician can be on a bespoke pay structure that still mirrors exactly what
  // they see in their own earnings ledger.
  baseFeeIndividual  Int?
  baseFeeCouples     Int?
  baseFeePsychiatry  Int?
  secondSessionBonus Int?
  thirdOnwardsBonus  Int?
  miscBonus          Int?
  nightSessionBonus  Int?
  // Admin-defined fields shown to a FULL_TIME (salaried) clinician on their
  // Earnings tab, in place of the per-session payout ledger (which only applies
  // to part-time). Each entry is { label, type: 'text'|'select', value,
  // options?: string[] } — a dropdown (admin picks from options) or a free-text
  // value. Read-only to the clinician; only admins edit them.
  compensationFields Json?
  // Onboarding attachments (certificates, registration proof, ID). Stored as
  // URLs or small inline data URLs, same convention as blog cover images.
  documentUrls    String[]
  photoUrl        String?
  createdAt       DateTime @default(now())

  appointments           Appointment[]           @relation("TherapistAppointments")
  availability           TherapistAvailability[]
  availabilityExceptions AvailabilityException[]
  supervisorLinks        SupervisionLink[]       @relation("Supervisor")
  superviseeLinks        SupervisionLink[]       @relation("Supervisee")
  reviews                SessionReview[]
  packages               Subscription[]          @relation("SubscriptionExpert")
}

// Recurring weekly availability template. One row per weekday the therapist works;
// `hours` are the enabled 1-hour slot start-hours (0-23) applied to every
// occurrence of that weekday. Date-specific changes live in AvailabilityException.
model TherapistAvailability {
  id          String           @id @default(cuid())
  therapistId String
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday … 6 = Saturday
  hours       Int[] // enabled slot start-hours, e.g. [7,8,9,10,12,13]
  updatedAt   DateTime         @updatedAt

  @@unique([therapistId, dayOfWeek])
}

// A date-specific override of the recurring template. `fullDayOff` blocks the
// entire date; otherwise `hoursOff` removes specific slot start-hours that date.
model AvailabilityException {
  id          String           @id @default(cuid())
  therapistId String
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  date        DateTime // midnight (UTC) of the affected calendar date
  fullDayOff  Boolean          @default(true)
  hoursOff    Int[]
  createdAt   DateTime         @default(now())

  @@unique([therapistId, date])
}

// Clinical supervision relationship between two therapists.
model SupervisionLink {
  id           String            @id @default(cuid())
  supervisorId String
  supervisor   TherapistProfile  @relation("Supervisor", fields: [supervisorId], references: [id], onDelete: Cascade)
  superviseeId String
  supervisee   TherapistProfile  @relation("Supervisee", fields: [superviseeId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  notes        SupervisionNote[]

  @@unique([supervisorId, superviseeId])
}

// A note shared within a supervision relationship. Authored by either party; may
// reference a specific patient case (User.id) the supervisee owns.
model SupervisionNote {
  id        String          @id @default(cuid())
  linkId    String
  link      SupervisionLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  authorId  String // TherapistProfile.id of the author
  patientId String? // optional case reference (User.id)
  content   String          @db.Text
  createdAt DateTime        @default(now())

  @@index([linkId, createdAt])
}

model Assessment {
  id             String         @id @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  type           AssessmentType
  responses      Json
  severityLevel  SeverityLevel
  areasOfConcern String[]
  completedAt    DateTime       @default(now())
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  patient        User              @relation("PatientAppointments", fields: [patientId], references: [id])
  therapistId    String
  therapist      TherapistProfile  @relation("TherapistAppointments", fields: [therapistId], references: [id])
  scheduledAt    DateTime
  durationMins   Int               @default(45)
  status         AppointmentStatus @default(PENDING)
  // Proprietary in-app WebRTC room. The patient & expert join the same roomId;
  // no external meeting provider is used (#4). meetLink kept for legacy/back-compat.
  roomId         String?
  meetLink       String?
  fee            Int
  notes          String?           @db.Text
  // Notes the patient prepares before the session, shared with the expert (#9).
  preSessionNote String?           @db.Text
  // Clinician's post-session summary the patient can read back later (#3).
  summary        String?           @db.Text
  // Presence tracking for the strict completion rule: a session counts as
  // COMPLETED only when BOTH sides joined, they were together for >= 30 min, and
  // a clinical note is written. Timestamps are set the first time each side
  // connects to the room; endedAt when the room closes.
  patientJoinedAt   DateTime?
  therapistJoinedAt DateTime?
  endedAt           DateTime?
  // The package a booking reserved a session against (wallet is decremented at
  // booking). On cancel > 24h / void it is restored and this is cleared.
  consumedSubscriptionId String?
  // Clinician-initiated cancellation goes through admin approval: the clinician
  // flags the appointment (with a reason) and it stays live until an admin
  // approves (real cancel + wallet restore) or rejects (flag cleared). Patient
  // cancellation is unaffected — it stays immediate.
  cancelRequested   Boolean   @default(false)
  cancelReason      String?   @db.Text
  cancelRequestedAt DateTime?
  createdAt      DateTime          @default(now())

  review         SessionReview?

  @@index([patientId])
  // Hot paths filter a patient's / clinician's appointments by status and time
  // (session settlement, "next session", schedule) — composite indexes keep
  // those lookups from scanning all of a person's rows.
  @@index([patientId, status, scheduledAt])
  @@index([therapistId, status, scheduledAt])
}

// A patient's rating of a completed session with their clinician. One per
// appointment. Submitting (or updating) one recomputes the clinician's
// denormalised rating + totalReviews, so the profile rating is always the real
// average of patient feedback — admins can read it but never hand-edit it.
model SessionReview {
  id            String           @id @default(cuid())
  appointmentId String           @unique
  appointment   Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User             @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  therapistId   String
  therapist     TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  rating        Int // 1–5
  comment       String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([therapistId])
}

// A patient's purchased care package. Drives session balance, category and the
// tenure-based membership tier (#5, #6, #7, #18). A patient may have history of
// several; the most recent ACTIVE one is the live plan.
model Subscription {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      CareCategory       @default(INDIVIDUAL)
  // Which of the 7 service tracks this package is for (slug: therapy,
  // psychiatry, couples, child, maternal, assessments, specialised).
  trackSlug     String
  // The expert attached to this package. A patient can hold several packages
  // (e.g. individual + couples + psychiatry), each with its own clinician.
  therapistId   String?
  therapist     TherapistProfile?  @relation("SubscriptionExpert", fields: [therapistId], references: [id])
  planName      String // e.g. "Calm+ Quarterly"
  tier          PlanTier           @default(STARTER)
  status        SubscriptionStatus @default(ACTIVE)
  // Cumulative paid months across renewals — feeds the tier calculation (#18).
  paidMonths    Int                @default(0)
  sessionsTotal Int                @default(0)
  sessionsUsed  Int                @default(0)
  // Remaining counselling minutes in the package, where sold by time (#6).
  minutesTotal  Int?
  minutesUsed   Int?
  startedAt     DateTime           @default(now())
  renewsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  payments      Payment[]

  @@index([userId])
  // The active-package lookup (dashboard, sidebar, billing) filters userId+status.
  @@index([userId, status])
}

// A single money-in event: what a patient actually paid for a purchase (a session
// pack, a first session, or a Calm+ plan). The Subscription record is topped up in
// place across renewals, so it can't carry a per-purchase amount — this ledger is
// the durable source of truth for revenue (all-time and per-period). Gross INR.
model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The subscription this purchase topped up / created. Null-safe: a deleted
  // subscription leaves the payment record intact for revenue history.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Int // gross amount paid, in INR
  kind           String // "package" | "first_session" | "calmplus"
  trackSlug      String?
  planName       String?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Singleton config for customer-facing pricing (id = "default"). Admin-editable;
// the packs/first-session prices are stored as JSON so packs can be re-priced
// without a schema change. Defaults (and the fallback when the row is missing)
// live in src/data/pricing.ts.
model PricingConfig {
  id              String   @id @default("default")
  // { therapy, psychiatry, couples } — flat first-session prices.
  firstSession    Json
  // SessionPack[] each: { sessions, months, total }.
  therapyPacks    Json
  psychiatryPacks Json
  couplesPacks    Json
  // AppPack[] each: { label, months, total }.
  calmPlusPacks   Json
  // MRP per single session (the struck-through list price packs discount from).
  therapyBase     Int      @default(1999)
  psychiatryBase  Int      @default(1999)
  couplesBase     Int      @default(3999)
  calmPlusBase    Int      @default(499)
  updatedBy       String?
  updatedAt       DateTime @updatedAt
}

// A daily task an expert assigns to a patient (exercise, video, reading…) shown
// under Home > Tasks (#16).
model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TaskType  @default(REFLECTION)
  title       String
  description String?   @db.Text
  // Optional link for VIDEO/READING tasks.
  resourceUrl String?
  assignedBy  String? // assigner's display name, denormalised (therapist or admin)
  // When set, the id of the User who assigned this task (therapist or admin),
  // for audit. `userId` is always the person the task is FOR — a patient for
  // therapist-assigned tasks, a therapist for admin-assigned tasks.
  assignedById String?
  // Recurrence: ONE_TIME (default) or DAILY / WEEKLY / FORTNIGHTLY / MONTHLY.
  // Recurring tasks re-open each period until dueDate; completedAt marks the
  // latest completion and "done" is derived per period.
  frequency   String?
  // Times of day to do the task, any of "Morning" / "Afternoon" / "Evening".
  // Empty means no specific time.
  timesOfDay  String[]  @default([])
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// A medication on the patient's regimen, with the prescribing doctor. Surfaced
// in the Expert Care > Medications tab, primarily for psychiatry patients (#14).
model Medication {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  dosage       String? // e.g. "20 mg"
  frequency    String? // e.g. "Once daily"
  // Times of day to take it, free-form (e.g. ["Morning", "Night"]).
  times        String[]
  prescribedBy String? // doctor name, patient- or doctor-entered
  notes        String?   @db.Text
  // How many days the course should be taken for (drives quantity for delivery).
  durationDays Int?
  startedAt    DateTime?
  endedAt      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  orders MedicationOrder[]

  @@index([userId])
}

// A home-delivery order for a prescribed medication. The patient enters delivery
// contact + address and pays in-app (mock today); fulfilment is later handed to a
// pharmacy partner (Tata 1mg etc.) via `provider` + `providerOrderId`.
model MedicationOrder {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationId   String?
  medication     Medication?           @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  // Snapshot of what was ordered, so the order is stable if the medication
  // record later changes: { name, dosage, durationDays }.
  item           Json
  status         MedicationOrderStatus @default(PENDING_PAYMENT)
  // Delivery details
  contactName    String
  phone          String
  addressLine    String
  city           String
  pincode        String
  amount         Int // total charged, in INR
  // Pharmacy partner once integrated.
  provider       String?
  providerOrderId String?
  createdAt      DateTime              @default(now())
  paidAt         DateTime?

  @@index([userId, status])
}

// A lightweight in-app notification for a user (e.g. "new prescription"). Shown
// in the topbar bell and the notifications page.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. "prescription", "form", "order"
  title     String
  body      String?  @db.Text
  href      String? // in-app link to act on it
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Singleton config for how therapist earnings are computed (#earnings). One row
// (id = "default"). Admin-editable; the values are the commercial pay structure.
model EarningsConfig {
  id                 String   @id @default("default")
  // Legacy single base fee, kept for backward compatibility. New code uses the
  // three per-service base fees below.
  baseFee            Int      @default(600)
  // Per-service base fee, paid once per completed session of that type.
  baseFeeIndividual  Int      @default(600)
  baseFeeCouples     Int      @default(900)
  baseFeePsychiatry  Int      @default(800)
  secondSessionBonus Int      @default(50)
  thirdOnwardsBonus  Int      @default(100)
  miscBonus          Int      @default(0)
  nightSessionBonus  Int      @default(200)
  updatedBy          String?
  updatedAt          DateTime @updatedAt
}

// Per-category data-collection switches (#17). When a category is off, that data
// is neither gathered for AI nor fed to any LLM. feedToLlm is a global override.
model PrivacySettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectSessions Boolean  @default(true)
  collectChats    Boolean  @default(true)
  collectMood     Boolean  @default(true)
  collectJournals Boolean  @default(true)
  // Master switch: even collected data is excluded from LLM inputs when false.
  feedToLlm       Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// The "abridged AI version" of a patient's data (#13): a compact, de-identified
// summary derived from raw data (respecting PrivacySettings) and used as the
// context input for Calm AI and insights. Populated by the AI pipeline later.
model AiProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Compact rolling summary the AI pipeline maintains.
  summary     String?   @db.Text
  // Structured signals (themes, recurring stressors, coping wins, etc.).
  signals     Json?
  lastBuiltAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// A generated insight — daily (home, from mood) or weekly (journal tab). Body is
// produced by the deferred AI integration (#10, #12); rows are scaffolded now.
model AiInsight {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      InsightKind
  title     String
  body      String      @db.Text
  // Generation metadata: { suggSource, dataSufficient, model, costUsd, patterns }.
  // `patterns` carries the Pattern[] cards (title/sub/tone) the dashboard renders.
  meta      Json?
  forDate   DateTime    @default(now())
  createdAt DateTime    @default(now())

  @@index([userId, kind])
}

// A single Calm AI chat message (#11). Stored per patient. Assistant replies are
// produced by the classified-routing pipeline (lib/ai/chat.ts); the classifier
// metadata is denormalised onto the row so trends, de-escalation and crisis
// detection survive across turns without re-classifying history.
model CalmAiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String   @db.Text
  // Classifier output for the turn this message belongs to (null for legacy /
  // rule-based rows). label e.g. "VENT_DISTRESS", intent, intensity low|high|crisis.
  label     String?
  intent    String?
  intensity String?
  // True when this turn was routed as high-stake (CRISIS / VENT_DISTRESS).
  highStake Boolean  @default(false)
  // Model that produced an assistant reply (e.g. "claude-haiku-4-5-20251001").
  model     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Expert-authored clinical context for a patient (1:1). Mirrors the notebook
// `assessment_track` block. Written by the care team on the expert dashboard and
// read (privacy-gated) by the AI pipeline — never invented by the model.
model ClinicalContext {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Current clinical scale in use and the latest trend word.
  scale             String? // e.g. "GAD-7", "PHQ-9"
  trend             String? // "improving" | "stable" | "declining"
  // What has and hasn't helped, and known recurring triggers.
  whatHasHelped     String[]
  whatHasNotHelped  String[]
  recurringTriggers String[]
  // Risk flags — drive crisis handling care level.
  passiveSiHistory  Boolean  @default(false)
  sleepDisturbance  Boolean  @default(false)
  safetyPlanActive  Boolean  @default(false)
  safetyPlanContact String?
  // Denormalised display name of the clinician who last edited this.
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// A point-in-time clinical scale score (time series). Mirrors the notebook
// `assessment_track.scores[]`. Lets the AI describe trends without inventing them.
model AssessmentScore {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scale      String // "GAD-7", "PHQ-9", ...
  score      Int
  label      String? // "Moderate", "Mild", ...
  recordedAt DateTime @default(now())

  @@index([userId, recordedAt])
}

// A crisis hand-off record. When the chat pipeline routes a turn as high-stake it
// writes one of these for the care team to follow up on, with a ready-to-read
// handoff note. This is the durable replacement for the notebook's
// crisis_alerts.jsonl side file.
model CrisisAlert {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientName    String?
  therapistName  String?
  therapistEmail String?
  label          String // "CRISIS" | "VENT_DISTRESS"
  question       String   @db.Text // what the patient said
  answer         String   @db.Text // what Calm AI replied
  handoffNote    String   @db.Text
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// One row per check-in (the grain we report on). mood/energy/calm are 0–10.
// Raw, patient-owned record; whether it feeds the AI pipeline is decided later
// by PrivacySettings, not here.
model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  mood      Int
  energy    Int
  calm      Int?
  sleep     Int?
  note      String?
  source    String? // e.g. "home-checkin"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A patient's journal entry — raw, patient-owned. AI inclusion is gated by
// PrivacySettings downstream.
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  content   String   @db.Text
  moodTag   String?
  topicTags String[]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Editorial blog post, authored in a clinician's voice. Body is stored as an
// ordered array of paragraphs. authorName/authorRole are denormalised so a post
// keeps its byline even if it is not tied to a User account (e.g. seeded content).
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  content     String[] // ordered paragraphs
  authorName  String
  authorRole  String
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  tags        String[]
  readTime    String
  // Optional author-supplied cover image. Stored as a URL or an inline data URL
  // (small uploads). When null, a tag-based stock cover is used at render time.
  coverImage  String?  @db.Text
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([publishedAt])
}

// A Reddit-style community discussion. Visible to everyone; only members may
// post or comment. authorName/authorRole/tenure are denormalised for display.
model CommunityPost {
  id         String        @id @default(cuid())
  title      String
  body       String        @db.Text
  authorName String
  authorRole CommunityRole @default(MEMBER)
  tenure     String? // e.g. "8 months" — drives the Paid Member star tier
  // Posted anonymously: authorName is stored as "Anonymous" and the role badge
  // is neutralised so peers can't identify the writer. authorId is still kept so
  // the author's own "My posts" filter and platform moderation keep working.
  anonymous  Boolean       @default(false)
  authorId   String?
  author     User?         @relation("UserCommunityPosts", fields: [authorId], references: [id])
  tags       String[]
  upvotes    Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  comments CommunityComment[]
  upvoteRecords CommunityUpvote[] @relation("PostUpvotes")

  @@index([createdAt])
}

model CommunityComment {
  id         String        @id @default(cuid())
  postId     String
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  authorRole CommunityRole @default(MEMBER)
  // Posted anonymously (see CommunityPost.anonymous).
  anonymous  Boolean       @default(false)
  authorId   String?
  author     User?         @relation("UserCommunityComments", fields: [authorId], references: [id])
  body       String        @db.Text
  upvotes    Int           @default(0)
  createdAt  DateTime      @default(now())

  upvoteRecords CommunityUpvote[] @relation("CommentUpvotes")

  @@index([postId])
}

// One row per member per upvoted target (post OR comment), so a vote can be
// toggled and never double-counted. The `upvotes` Int on the post/comment is a
// denormalised counter kept in sync inside the same transaction, so all read
// paths (and the seed fallback) keep working without a join.
model CommunityUpvote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserCommunityUpvotes", fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      CommunityPost? @relation("PostUpvotes", fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   CommunityComment? @relation("CommentUpvotes", fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
}

// A Calm Club poll: admin-authored question with fixed options and an optional
// expiry. Members cast one vote each; results are the tallied PollVote rows.
model Poll {
  id        String     @id @default(cuid())
  question  String
  options   String[] // the choices, in display order
  expiresAt DateTime? // null = never expires
  // Pinned polls sort to the top of the Polls tab (admin-controlled).
  pinned    Boolean    @default(false)
  createdBy String? // admin User id, for audit
  createdAt DateTime   @default(now())

  votes     PollVote[]

  @@index([createdAt])
}

// One vote per member per poll (enforced by the unique index). optionIndex points
// into Poll.options.
model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
}

// A reusable form in the clinical library — consent, intake/information sheets,
// questionnaires. The actual fields live in `fields` as an ordered JSON array of
// { key, label, type, options?, required } so new forms need no schema change.
// Clinicians send these to patients on demand; INTAKE forms flagged `autoSend`
// are dispatched automatically when a patient books their first session, picking
// the variant whose `category` matches the patient's care category.
model FormTemplate {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String?          @db.Text
  kind        FormKind         @default(INFO)
  // For INTAKE forms, which care category this variant is for (Individual /
  // Couple / Kids). Null = applies regardless of category.
  category    CareCategory?
  // When true (INTAKE only), auto-sent on the patient's first booking.
  autoSend    Boolean          @default(false)
  fields      Json // ordered [{ key, label, type, options?, required }]
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignments FormAssignment[]
  autoRules   FormAutoRule[]

  @@index([kind])
}

// A default-form rule: automatically send a form after a booking, based on the
// package/session type and the session number for that type. Recurrence is
// ONCE (a specific session number), EVERY, EVEN or ODD session. A rule is
// platform-wide (therapistId null, set by an admin) or scoped to one clinician's
// own patients (therapistId set, created by that expert).
model FormAutoRule {
  id            String       @id @default(cuid())
  templateId    String
  template      FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // Which package/session type this applies to: therapy | psychiatry | couples,
  // or "any" for all types.
  trackSlug     String       @default("any")
  // ONCE | EVERY | EVEN | ODD (kept as text so the on-demand schema-heal needs no enum).
  recurrence    String       @default("ONCE")
  // The session number this fires on, for ONCE rules. Ignored for the others.
  sessionNumber Int?
  // Null = platform-wide (admin). Set = only this clinician's patients (expert).
  therapistId   String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@index([active])
  @@index([therapistId])
}

// A form sent to a specific patient. Carries its own status + responses so the
// patient fills it in from their dashboard and the clinician sees it completed.
model FormAssignment {
  id           String       @id @default(cuid())
  templateId   String
  template     FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  patientId    String
  patient      User         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // Therapist display name, or "Auto" for default-rule sends. Denormalised.
  assignedBy   String?
  status       FormStatus   @default(PENDING)
  // Patient's answers, keyed by field.key. Null until submitted.
  responses    Json?
  note         String?      @db.Text
  sentAt       DateTime     @default(now())
  completedAt  DateTime?

  @@index([patientId, status])
}

// A "Contact us" form submission from the public site. Triaged by admins.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

// An "Enterprise interest" lead from the public enterprise page.
model EnterpriseLead {
  id           String   @id @default(cuid())
  name         String
  email        String
  organisation String?
  sector       String? // "Corporate", "Education", "Hospital", …
  teamSize     String? // free-text bucket, e.g. "51–200"
  phone        String?
  message      String?  @db.Text
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([handled, createdAt])
}

// Durable WebRTC signaling relay. The in-app video room exchanges SDP
// offers/answers + ICE candidates through short-polling until a direct P2P
// connection forms. This MUST be a shared store, not per-instance memory: on
// serverless (Vercel) the two participants hit different instances, so an
// in-memory relay never lets their signals meet. Rows are swept after a short
// TTL; no media ever touches the DB — only the tiny setup handshake.
model WebrtcSignal {
  seq       Int      @id @default(autoincrement())
  roomId    String
  peerId    String
  kind      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([roomId, seq])
  @@index([createdAt])
}

// One referral relationship: a referrer invited a referee, who is rewarded on
// their first qualifying package purchase. Status: PENDING → QUALIFIED (referee
// bought) → REWARDED (both rewards granted) → REVOKED (clawed back on refund).
model Referral {
  id                  String    @id @default(cuid())
  referrerId          String
  referrer            User      @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId           String    @unique
  referee             User      @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)
  status              String    @default("PENDING")
  qualifyingPaymentId String?
  referrerRewardKind  String? // WALLET_CREDIT | FREE_SESSION (snapshot of config at reward time)
  referrerRewardValue Int? // rupees, or session count
  refereeDiscount     Int? // rupees taken off the referee's first purchase
  createdAt           DateTime  @default(now())
  qualifiedAt         DateTime?

  @@index([referrerId])
  @@index([status])
}

// Singleton program settings, admin-editable. When enabled is false the whole
// program is off (patient UI hidden, no rewards granted).
model ReferralConfig {
  id                  String   @id @default("default")
  enabled             Boolean  @default(false)
  referrerRewardKind  String   @default("WALLET_CREDIT") // WALLET_CREDIT | FREE_SESSION | NONE
  referrerRewardValue Int      @default(500) // rupees (WALLET_CREDIT) or session count (FREE_SESSION)
  refereeDiscount     Int      @default(500) // rupees off the referee's first package (0 = none)
  clawback            Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}
