generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for serverless runtime (Supabase transaction pooler / Neon pooled).
  url       = env("DATABASE_URL")
  // Direct connection for `prisma migrate` (Supabase session pooler / Neon direct).
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AssessmentType {
  ADULT
  CHILD
  COUPLE
  PSYCHIATRY
}

enum SeverityLevel {
  MINIMAL
  MILD
  MODERATE
  SEVERE
}

// Whether a patient is currently in individual or couple care. A patient can be
// moved between modes over time; when in COUPLE mode they also carry a coupleId
// shared with their partner, while keeping their own stable individual patientId.
enum CareMode {
  INDIVIDUAL
  COUPLE
}

// A person attached to a patient's care context — a partner (for couples work)
// or a child/dependent (for child & adolescent therapy).
enum RelationType {
  PARTNER
  CHILD
  DEPENDENT
}

// The "Paid member" sub-category a patient sits in. Distinct from CareMode:
// CareMode is the clinical individual/couple distinction; CareCategory is the
// product bucket the subscription is sold under (Individual / Couple / Kids).
// A patient can switch between these (e.g. individual <-> couple, #19).
enum CareCategory {
  INDIVIDUAL
  COUPLE
  KIDS
}

// Tenure-based membership tier. Derived from the number of paid months on an
// active subscription (#18) and surfaced as a badge across the app.
enum PlanTier {
  STARTER // < 3 paid months
  BRONZE // 3–5 months
  SILVER // 6–11 months
  GOLD // 12–23 months
  PLATINUM // 24+ months
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

// Kind of expert-assigned task surfaced in the Home > Tasks tab (#16).
enum TaskType {
  EXERCISE
  VIDEO
  READING
  REFLECTION
  BREATHING
}

enum InsightKind {
  DAILY // home-page daily insight from mood tracker (#10)
  WEEKLY // weekly journal insight (#12)
}

enum ChatRole {
  USER
  ASSISTANT
}

enum TherapistApplicationStatus {
  APPLIED
  INTERVIEW_SCHEDULED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Role shown next to a community author. PAID_MEMBER carries a tenure-based star
// tier; clinicians (THERAPIST / PSYCHIATRIST) and ADMIN are verified badges.
enum CommunityRole {
  PAID_MEMBER
  MEMBER
  THERAPIST
  PSYCHIATRIST
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  image         String?
  // Salted scrypt hash for email+password sign-in (scrypt$salt$hash). Null for
  // accounts that only use OAuth / OTP. Never the raw password.
  passwordHash  String?
  role          Role      @default(PATIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  therapistProfile    TherapistProfile?
  patientProfile      PatientProfile?
  assessments         Assessment[]
  patientAppointments Appointment[]      @relation("PatientAppointments")
  moodEntries         MoodEntry[]
  journalEntries      JournalEntry[]
  blogPosts           BlogPost[]
  communityPosts      CommunityPost[]    @relation("UserCommunityPosts")
  communityComments   CommunityComment[] @relation("UserCommunityComments")
  subscriptions       Subscription[]
  tasks               Task[]
  medications         Medication[]
  privacySettings     PrivacySettings?
  aiProfile           AiProfile?
  aiInsights          AiInsight[]
  calmAiMessages      CalmAiMessage[]
  clinicalContext     ClinicalContext?
  assessmentScores    AssessmentScore[]
  crisisAlerts        CrisisAlert[]
}

// Patient-side record holding identity, care context, contacts and consents.
model PatientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stable, human-readable individual identifier (e.g. "GC-P-000123"). A patient
  // keeps this for life, regardless of moving between individual and couple care.
  patientId String   @unique
  // Shared identifier across both partners in a couple; null for individuals.
  // Both partners still keep their own patientId.
  coupleId  String?
  careMode  CareMode @default(INDIVIDUAL)

  // What the patient is being treated for — concern "tracks" (e.g. ["anxiety",
  // "postpartum"]). Drives matching, the care journey, and clinician context.
  track String[]

  // Display + clinical context the AI pipeline reads (mirrors the notebook
  // `patients.json` vocabulary so the expert dashboard and the AI share fields).
  // A human-readable label for the primary track (e.g. "Anxiety and Overthinking")
  // and an optional finer sub-track. trackLabel is an override; when null it is
  // derived from the track slug in code (lib/tracks.ts).
  trackLabel       String?
  subTrack         String?
  // Working clinical diagnosis, expert-authored (e.g. "Generalized Anxiety Disorder").
  diagnosis        String?
  // Free-text situational note the AI must read before suggesting actions, so it
  // never proposes partner/relationship steps that don't fit the patient's life.
  currentSituation String? @db.Text
  // Lifecycle of care (e.g. "active", "paused", "discharged").
  therapyStatus    String?

  // Personal & contact
  dateOfBirth       DateTime?
  gender            String?
  country           String    @default("IN") // ISO 3166-1 alpha-2, India default
  preferredLanguage String?

  // Emergency contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Consents (mental-health sensitive — captured explicitly at signup)
  dataRetentionConsent  Boolean   @default(false)
  // Whether de-identified data may be shared with LLM partners; user can toggle
  // this off later from settings without affecting other services.
  llmDataSharingConsent Boolean   @default(false)
  aiDisclaimerAck       Boolean   @default(false)
  liabilityAck          Boolean   @default(false)
  termsAcceptedAt       DateTime?

  relatedPeople RelatedPerson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId])
}

// A partner or child/dependent linked to a patient's care context.
model RelatedPerson {
  id          String         @id @default(cuid())
  profileId   String
  profile     PatientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  relation    RelationType
  name        String
  dateOfBirth DateTime?
  gender      String?
  phone       String?
  email       String?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([profileId])
}

// Specialist onboarding application. Submitted from the "For Therapists" signup,
// routed to admins for verification + interview before a TherapistProfile is live.
model TherapistApplication {
  id                   String                     @id @default(cuid())
  fullName             String
  email                String
  phone                String
  council              String // "RCI", "NMC", or "RCI+NMC"
  registrationNo       String
  yearsExp             Int
  qualifications       String[]
  specializations      String[]
  languages            String[]
  bio                  String?                    @db.Text
  documentUrls         String[] // uploaded certificates, registration proof, ID
  preferredInterviewAt DateTime?
  status               TherapistApplicationStatus @default(APPLIED)
  reviewerNotes        String?                    @db.Text
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
}

model TherapistProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  bio             String   @db.Text
  qualifications  String[]
  yearsExp        Int
  languages       String[]
  specializations String[]
  rciNumber       String   @unique
  sessionFee      Int
  rating          Float    @default(0)
  totalReviews    Int      @default(0)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  photoUrl        String?
  createdAt       DateTime @default(now())

  appointments Appointment[] @relation("TherapistAppointments")
}

model Assessment {
  id             String         @id @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  type           AssessmentType
  responses      Json
  severityLevel  SeverityLevel
  areasOfConcern String[]
  completedAt    DateTime       @default(now())
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  patient        User              @relation("PatientAppointments", fields: [patientId], references: [id])
  therapistId    String
  therapist      TherapistProfile  @relation("TherapistAppointments", fields: [therapistId], references: [id])
  scheduledAt    DateTime
  durationMins   Int               @default(50)
  status         AppointmentStatus @default(PENDING)
  // Proprietary in-app WebRTC room. The patient & expert join the same roomId;
  // no external meeting provider is used (#4). meetLink kept for legacy/back-compat.
  roomId         String?
  meetLink       String?
  fee            Int
  notes          String?           @db.Text
  // Notes the patient prepares before the session, shared with the expert (#9).
  preSessionNote String?           @db.Text
  // Clinician's post-session summary the patient can read back later (#3).
  summary        String?           @db.Text
  createdAt      DateTime          @default(now())

  @@index([patientId])
}

// A patient's purchased care package. Drives session balance, category and the
// tenure-based membership tier (#5, #6, #7, #18). A patient may have history of
// several; the most recent ACTIVE one is the live plan.
model Subscription {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      CareCategory       @default(INDIVIDUAL)
  // Which of the 7 service tracks this package is for (slug: therapy,
  // psychiatry, couples, child, maternal, assessments, specialised).
  trackSlug     String
  planName      String // e.g. "Calm+ Quarterly"
  tier          PlanTier           @default(STARTER)
  status        SubscriptionStatus @default(ACTIVE)
  // Cumulative paid months across renewals — feeds the tier calculation (#18).
  paidMonths    Int                @default(0)
  sessionsTotal Int                @default(0)
  sessionsUsed  Int                @default(0)
  // Remaining counselling minutes in the package, where sold by time (#6).
  minutesTotal  Int?
  minutesUsed   Int?
  startedAt     DateTime           @default(now())
  renewsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
}

// A daily task an expert assigns to a patient (exercise, video, reading…) shown
// under Home > Tasks (#16).
model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TaskType  @default(REFLECTION)
  title       String
  description String?   @db.Text
  // Optional link for VIDEO/READING tasks.
  resourceUrl String?
  assignedBy  String? // therapist display name, denormalised
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// A medication on the patient's regimen, with the prescribing doctor. Surfaced
// in the Expert Care > Medications tab, primarily for psychiatry patients (#14).
model Medication {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  dosage       String? // e.g. "20 mg"
  frequency    String? // e.g. "Once daily"
  // Times of day to take it, free-form (e.g. ["Morning", "Night"]).
  times        String[]
  prescribedBy String? // doctor name, patient- or doctor-entered
  notes        String?   @db.Text
  startedAt    DateTime?
  endedAt      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// Per-category data-collection switches (#17). When a category is off, that data
// is neither gathered for AI nor fed to any LLM. feedToLlm is a global override.
model PrivacySettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectSessions Boolean  @default(true)
  collectChats    Boolean  @default(true)
  collectMood     Boolean  @default(true)
  collectJournals Boolean  @default(true)
  // Master switch: even collected data is excluded from LLM inputs when false.
  feedToLlm       Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// The "abridged AI version" of a patient's data (#13): a compact, de-identified
// summary derived from raw data (respecting PrivacySettings) and used as the
// context input for Calm AI and insights. Populated by the AI pipeline later.
model AiProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Compact rolling summary the AI pipeline maintains.
  summary     String?   @db.Text
  // Structured signals (themes, recurring stressors, coping wins, etc.).
  signals     Json?
  lastBuiltAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// A generated insight — daily (home, from mood) or weekly (journal tab). Body is
// produced by the deferred AI integration (#10, #12); rows are scaffolded now.
model AiInsight {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      InsightKind
  title     String
  body      String      @db.Text
  // Generation metadata: { suggSource, dataSufficient, model, costUsd, patterns }.
  // `patterns` carries the Pattern[] cards (title/sub/tone) the dashboard renders.
  meta      Json?
  forDate   DateTime    @default(now())
  createdAt DateTime    @default(now())

  @@index([userId, kind])
}

// A single Calm AI chat message (#11). Stored per patient. Assistant replies are
// produced by the classified-routing pipeline (lib/ai/chat.ts); the classifier
// metadata is denormalised onto the row so trends, de-escalation and crisis
// detection survive across turns without re-classifying history.
model CalmAiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String   @db.Text
  // Classifier output for the turn this message belongs to (null for legacy /
  // rule-based rows). label e.g. "VENT_DISTRESS", intent, intensity low|high|crisis.
  label     String?
  intent    String?
  intensity String?
  // True when this turn was routed as high-stake (CRISIS / VENT_DISTRESS).
  highStake Boolean  @default(false)
  // Model that produced an assistant reply (e.g. "claude-haiku-4-5-20251001").
  model     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Expert-authored clinical context for a patient (1:1). Mirrors the notebook
// `assessment_track` block. Written by the care team on the expert dashboard and
// read (privacy-gated) by the AI pipeline — never invented by the model.
model ClinicalContext {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Current clinical scale in use and the latest trend word.
  scale             String? // e.g. "GAD-7", "PHQ-9"
  trend             String? // "improving" | "stable" | "declining"
  // What has and hasn't helped, and known recurring triggers.
  whatHasHelped     String[]
  whatHasNotHelped  String[]
  recurringTriggers String[]
  // Risk flags — drive crisis handling care level.
  passiveSiHistory  Boolean  @default(false)
  sleepDisturbance  Boolean  @default(false)
  safetyPlanActive  Boolean  @default(false)
  safetyPlanContact String?
  // Denormalised display name of the clinician who last edited this.
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// A point-in-time clinical scale score (time series). Mirrors the notebook
// `assessment_track.scores[]`. Lets the AI describe trends without inventing them.
model AssessmentScore {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scale      String // "GAD-7", "PHQ-9", ...
  score      Int
  label      String? // "Moderate", "Mild", ...
  recordedAt DateTime @default(now())

  @@index([userId, recordedAt])
}

// A crisis hand-off record. When the chat pipeline routes a turn as high-stake it
// writes one of these for the care team to follow up on, with a ready-to-read
// handoff note. This is the durable replacement for the notebook's
// crisis_alerts.jsonl side file.
model CrisisAlert {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientName    String?
  therapistName  String?
  therapistEmail String?
  label          String // "CRISIS" | "VENT_DISTRESS"
  question       String   @db.Text // what the patient said
  answer         String   @db.Text // what Calm AI replied
  handoffNote    String   @db.Text
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// One row per check-in (the grain we report on). mood/energy/calm are 0–10.
// Raw, patient-owned record; whether it feeds the AI pipeline is decided later
// by PrivacySettings, not here.
model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  mood      Int
  energy    Int
  calm      Int?
  sleep     Int?
  note      String?
  source    String? // e.g. "home-checkin"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A patient's journal entry — raw, patient-owned. AI inclusion is gated by
// PrivacySettings downstream.
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  content   String   @db.Text
  moodTag   String?
  topicTags String[]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Editorial blog post, authored in a clinician's voice. Body is stored as an
// ordered array of paragraphs. authorName/authorRole are denormalised so a post
// keeps its byline even if it is not tied to a User account (e.g. seeded content).
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  content     String[] // ordered paragraphs
  authorName  String
  authorRole  String
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  tags        String[]
  readTime    String
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([publishedAt])
}

// A Reddit-style community discussion. Visible to everyone; only members may
// post or comment. authorName/authorRole/tenure are denormalised for display.
model CommunityPost {
  id         String        @id @default(cuid())
  title      String
  body       String        @db.Text
  authorName String
  authorRole CommunityRole @default(MEMBER)
  tenure     String? // e.g. "8 months" — drives the Paid Member star tier
  authorId   String?
  author     User?         @relation("UserCommunityPosts", fields: [authorId], references: [id])
  tags       String[]
  upvotes    Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  comments CommunityComment[]

  @@index([createdAt])
}

model CommunityComment {
  id         String        @id @default(cuid())
  postId     String
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  authorRole CommunityRole @default(MEMBER)
  authorId   String?
  author     User?         @relation("UserCommunityComments", fields: [authorId], references: [id])
  body       String        @db.Text
  upvotes    Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([postId])
}
