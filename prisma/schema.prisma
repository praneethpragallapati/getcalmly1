generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for serverless runtime (Supabase transaction pooler / Neon pooled).
  url       = env("DATABASE_URL")
  // Direct connection for `prisma migrate` (Supabase session pooler / Neon direct).
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AssessmentType {
  ADULT
  CHILD
  COUPLE
  PSYCHIATRY
}

enum SeverityLevel {
  MINIMAL
  MILD
  MODERATE
  SEVERE
}

// Whether a patient is currently in individual or couple care. A patient can be
// moved between modes over time; when in COUPLE mode they also carry a coupleId
// shared with their partner, while keeping their own stable individual patientId.
enum CareMode {
  INDIVIDUAL
  COUPLE
}

// A person attached to a patient's care context — a partner (for couples work)
// or a child/dependent (for child & adolescent therapy).
enum RelationType {
  PARTNER
  CHILD
  DEPENDENT
}

enum TherapistApplicationStatus {
  APPLIED
  INTERVIEW_SCHEDULED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Role shown next to a community author. PAID_MEMBER carries a tenure-based star
// tier; clinicians (THERAPIST / PSYCHIATRIST) and ADMIN are verified badges.
enum CommunityRole {
  PAID_MEMBER
  MEMBER
  THERAPIST
  PSYCHIATRIST
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  image         String?
  role          Role      @default(PATIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  therapistProfile    TherapistProfile?
  patientProfile      PatientProfile?
  assessments         Assessment[]
  patientAppointments Appointment[]     @relation("PatientAppointments")
  moodEntries         MoodEntry[]
  journalEntries      JournalEntry[]
  blogPosts           BlogPost[]
  communityPosts      CommunityPost[]    @relation("UserCommunityPosts")
  communityComments   CommunityComment[] @relation("UserCommunityComments")
}

// Patient-side record holding identity, care context, contacts and consents.
model PatientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stable, human-readable individual identifier (e.g. "GC-P-000123"). A patient
  // keeps this for life, regardless of moving between individual and couple care.
  patientId String   @unique
  // Shared identifier across both partners in a couple; null for individuals.
  // Both partners still keep their own patientId.
  coupleId  String?
  careMode  CareMode @default(INDIVIDUAL)

  // What the patient is being treated for — concern "tracks" (e.g. ["anxiety",
  // "postpartum"]). Drives matching, the care journey, and clinician context.
  track String[]

  // Personal & contact
  dateOfBirth       DateTime?
  gender            String?
  country           String    @default("IN") // ISO 3166-1 alpha-2, India default
  preferredLanguage String?

  // Emergency contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Consents (mental-health sensitive — captured explicitly at signup)
  dataRetentionConsent  Boolean   @default(false)
  // Whether de-identified data may be shared with LLM partners; user can toggle
  // this off later from settings without affecting other services.
  llmDataSharingConsent Boolean   @default(false)
  aiDisclaimerAck       Boolean   @default(false)
  liabilityAck          Boolean   @default(false)
  termsAcceptedAt       DateTime?

  relatedPeople RelatedPerson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId])
}

// A partner or child/dependent linked to a patient's care context.
model RelatedPerson {
  id          String         @id @default(cuid())
  profileId   String
  profile     PatientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  relation    RelationType
  name        String
  dateOfBirth DateTime?
  gender      String?
  phone       String?
  email       String?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([profileId])
}

// Specialist onboarding application. Submitted from the "For Therapists" signup,
// routed to admins for verification + interview before a TherapistProfile is live.
model TherapistApplication {
  id                   String                     @id @default(cuid())
  fullName             String
  email                String
  phone                String
  council              String // "RCI", "NMC", or "RCI+NMC"
  registrationNo       String
  yearsExp             Int
  qualifications       String[]
  specializations      String[]
  languages            String[]
  bio                  String?                    @db.Text
  documentUrls         String[] // uploaded certificates, registration proof, ID
  preferredInterviewAt DateTime?
  status               TherapistApplicationStatus @default(APPLIED)
  reviewerNotes        String?                    @db.Text
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
}

model TherapistProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  bio             String   @db.Text
  qualifications  String[]
  yearsExp        Int
  languages       String[]
  specializations String[]
  rciNumber       String   @unique
  sessionFee      Int
  rating          Float    @default(0)
  totalReviews    Int      @default(0)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  photoUrl        String?
  createdAt       DateTime @default(now())

  appointments Appointment[] @relation("TherapistAppointments")
}

model Assessment {
  id             String         @id @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  type           AssessmentType
  responses      Json
  severityLevel  SeverityLevel
  areasOfConcern String[]
  completedAt    DateTime       @default(now())
}

model Appointment {
  id           String            @id @default(cuid())
  patientId    String
  patient      User              @relation("PatientAppointments", fields: [patientId], references: [id])
  therapistId  String
  therapist    TherapistProfile  @relation("TherapistAppointments", fields: [therapistId], references: [id])
  scheduledAt  DateTime
  durationMins Int               @default(50)
  status       AppointmentStatus @default(PENDING)
  meetLink     String?
  fee          Int
  notes        String?           @db.Text
  createdAt    DateTime          @default(now())
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  mood      Int
  energy    Int
  sleep     Int
  note      String?
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String   @db.Text
  moodTag   String?
  topicTags String[]
  createdAt DateTime @default(now())
}

// Editorial blog post, authored in a clinician's voice. Body is stored as an
// ordered array of paragraphs. authorName/authorRole are denormalised so a post
// keeps its byline even if it is not tied to a User account (e.g. seeded content).
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  content     String[] // ordered paragraphs
  authorName  String
  authorRole  String
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  tags        String[]
  readTime    String
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([publishedAt])
}

// A Reddit-style community discussion. Visible to everyone; only members may
// post or comment. authorName/authorRole/tenure are denormalised for display.
model CommunityPost {
  id         String        @id @default(cuid())
  title      String
  body       String        @db.Text
  authorName String
  authorRole CommunityRole @default(MEMBER)
  tenure     String? // e.g. "8 months" — drives the Paid Member star tier
  authorId   String?
  author     User?         @relation("UserCommunityPosts", fields: [authorId], references: [id])
  tags       String[]
  upvotes    Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  comments CommunityComment[]

  @@index([createdAt])
}

model CommunityComment {
  id         String        @id @default(cuid())
  postId     String
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  authorRole CommunityRole @default(MEMBER)
  authorId   String?
  author     User?         @relation("UserCommunityComments", fields: [authorId], references: [id])
  body       String        @db.Text
  upvotes    Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([postId])
}
